<Page
    x:Class="GameLibrary.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource BackgroundBaseBrush}">

    <Page.Resources>
        <!-- 分区卡片：白 5% 圆角 16，对齐 Game Box Section (rounded-2xl bg-white/5 p-5) -->
        <Style x:Key="SettingsSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
        <!-- 分区标题 18px SemiBold white/90 -->
        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!-- 字段标签 14px white/70 -->
        <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 值文本 14px white/80 -->
        <Style x:Key="SettingsValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 下拉框：白 5% 圆角 8，对齐前端 select -->
        <Style x:Key="SettingsSelectStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8,12,9" />
            <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- 文本输入：白 10% 圆角 8，垂直 padding 光学居中（WinUI 文本对齐不受 VerticalContentAlignment 控制） -->
        <Style x:Key="SettingsInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,8,12,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- 密码输入：白 10% 圆角 8，垂直 padding 光学居中 -->
        <Style x:Key="SettingsSecretStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,8,12,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- 胶囊开关：透明毛玻璃（无实色背景），开 white/15 白字，关 白描边 white/60 -->
        <Style x:Key="SettingsToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource RoundedToggleButtonTemplate}" />
        </Style>
        <!-- glass 按钮：border-white/10 bg-white/5 圆角 8 -->
        <Style x:Key="SettingsGlassButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="48,104,48,40" Spacing="0" HorizontalAlignment="Stretch">

            <!-- 页面标题：30px ExtraBold white，对齐前端 h1 -->
            <TextBlock Text="设置" Tag="i18n:settings.title" FontFamily="Hanken Grotesk, Segoe UI" FontSize="30" FontWeight="ExtraBold"
                       Foreground="White" Margin="0,0,0,24" />

            <!-- 来源检测 -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel>
                    <TextBlock Text="来源检测" Tag="i18n:settings.sourceDetection" Style="{StaticResource SettingsLabelStyle}" />
                    <StackPanel x:Name="SourceDetectionPanel" Spacing="12" />
                </StackPanel>
            </Border>

            <!-- 在线元数据 -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="在线元数据" Tag="i18n:settings.metadata" Style="{StaticResource SettingsLabelStyle}" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="元数据提供方" Tag="i18n:settings.provider" Style="{StaticResource SettingsFieldLabelStyle}" />
                        <ComboBox x:Name="ProviderBox" Style="{StaticResource SettingsSelectStyle}">
                            <ComboBoxItem Content="自动（IGDB + SGDB）" Tag="i18n:settings.provider.auto" />
                            <ComboBoxItem Content="仅 IGDB" Tag="i18n:settings.provider.igdb" />
                            <ComboBoxItem Content="仅 SteamGridDB" Tag="i18n:settings.provider.sgdb" />
                        </ComboBox>
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="导入后自动抓取元数据" Tag="i18n:settings.autoFetch" Grid.Column="0" Style="{StaticResource SettingsFieldLabelStyle}" />
                        <ToggleButton x:Name="AutoFetchToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="外观" Tag="i18n:settings.appearance" Style="{StaticResource SettingsLabelStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="首页轮播间隔（秒）" Tag="i18n:settings.heroInterval" Grid.Column="0" Style="{StaticResource SettingsFieldLabelStyle}" />
                        <TextBox x:Name="CarouselIntervalBox" Grid.Column="1" Style="{StaticResource SettingsInputStyle}"
                                 Width="72" Text="8" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="首页自动轮播" Tag="i18n:settings.autoCarousel" Grid.Column="0" Style="{StaticResource SettingsFieldLabelStyle}" />
                        <ToggleButton x:Name="AutoCarouselToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" />
                    </Grid>
                    <TextBlock Text="范围 3–30 秒，控制首页 Hero 卡片与动态背景自动切换节奏。" Tag="i18n:settings.heroIntervalHint"
                               FontFamily="Hanken Grotesk, Segoe UI" FontSize="12" Foreground="#8D90A1" />
                </StackPanel>
            </Border>

            <!-- 语言 -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="语言" Tag="i18n:settings.language" Style="{StaticResource SettingsLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="LanguageBox" Width="180" Style="{StaticResource SettingsSelectStyle}"
                                  SelectionChanged="LanguageBox_SelectionChanged">
                            <ComboBoxItem Content="简体中文" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                        <TextBlock Text="切换后立即全局生效" Tag="i18n:settings.languageHint" Style="{StaticResource SettingsFieldLabelStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- IGDB -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="IGDB" Tag="i18n:settings.igdbTitle" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="用于获取游戏简介与封面。在 https://dev.twitch.tv/console/apps 注册应用。" Tag="i18n:settings.igdbHint"
                               FontFamily="Hanken Grotesk, Segoe UI" FontSize="12" Foreground="#8D90A1" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Client ID" Tag="i18n:settings.igdbClientId" Style="{StaticResource SettingsFieldLabelStyle}" />
                        <TextBox x:Name="IgdbClientId" Style="{StaticResource SettingsInputStyle}" PlaceholderText="Client ID" Tag="i18nph:settings.igdbClientId" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Client Secret" Tag="i18n:settings.igdbSecret" Style="{StaticResource SettingsFieldLabelStyle}" />
                        <PasswordBox x:Name="IgdbSecret" Style="{StaticResource SettingsSecretStyle}" PlaceholderText="Client Secret" Tag="i18nph:settings.igdbSecret" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SteamGridDB -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="SteamGridDB" Tag="i18n:settings.sgdbTitle" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="用于获取游戏网格图片与封面。在 https://www.steamgriddb.com/profile/preferences/api 申请密钥。" Tag="i18n:settings.sgdbHint"
                               FontFamily="Hanken Grotesk, Segoe UI" FontSize="12" Foreground="#8D90A1" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="API Key" Tag="i18n:settings.sgdbKey" Style="{StaticResource SettingsFieldLabelStyle}" />
                        <PasswordBox x:Name="SteamGridDbKey" Style="{StaticResource SettingsSecretStyle}" PlaceholderText="API Key" Tag="i18nph:settings.sgdbKey" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 软件激活 -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="软件激活" Style="{StaticResource SettingsLabelStyle}" />
                    <TextBlock Text="本软件为付费授权。复制下方机器码发送给开发者以获取激活码，激活后绑定本机。"
                               FontFamily="Hanken Grotesk, Segoe UI" FontSize="12" Foreground="#8D90A1" TextWrapping="Wrap" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="机器码" Style="{StaticResource SettingsFieldLabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MachineCodeBox" Grid.Column="0" Style="{StaticResource SettingsInputStyle}" IsReadOnly="True" />
                            <Button x:Name="CopyMachineCodeButton" Grid.Column="1" Content="复制" Click="CopyMachineCode_Click" Style="{StaticResource SettingsGlassButtonStyle}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="激活码" Style="{StaticResource SettingsFieldLabelStyle}" />
                        <TextBox x:Name="ActivationCodeBox" Style="{StaticResource SettingsInputStyle}" PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Button x:Name="ActivateButton" Content="激活" Click="ActivateButton_Click" Style="{StaticResource SettingsGlassButtonStyle}" />
                        <Button x:Name="RemoveActivationButton" Content="移除激活" Click="RemoveActivation_Click" Style="{StaticResource SettingsGlassButtonStyle}" />
                        <TextBlock x:Name="ActivationStatusText" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource SettingsSectionStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="关于" Style="{StaticResource SettingsLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="作者：" Style="{StaticResource SettingsFieldLabelStyle}" />
                        <HyperlinkButton Content="cantinzing@163.com" NavigateUri="mailto:cantinzing@163.com" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 保存 -->
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="4,0,0,0">
            <Button Content="保存设置" Tag="i18n:settings.save" Click="SaveButton_Click" Style="{StaticResource SettingsGlassButtonStyle}" />
            <TextBlock x:Name="StatusText" Style="{StaticResource MonoLabelStyle}"
                        Foreground="#C3C6D8" VerticalAlignment="Center" />
        </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
