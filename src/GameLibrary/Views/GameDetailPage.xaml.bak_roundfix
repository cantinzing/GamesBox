<Page
    x:Class="GameLibrary.GameDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="DetailTagPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9999" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
        <!-- 顶部小按钮（Back / Favorite，bg-white/5） -->
        <Style x:Key="DetailToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource BackgroundBaseBrush}">
        <!-- 全屏沉浸背景（暗渐变 + 底部灯罩，对齐 GameDetail.tsx bg-ink-950/80） -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#16283F" Offset="0" />
                    <GradientStop Color="#121318" Offset="0.6" />
                    <GradientStop Color="#0D0E13" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border Background="{ThemeResource BottomFadeBrush}" />

        <ScrollViewer>
            <Grid Padding="48,104,48,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶部操作条：Back + Favorite -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,32">
                    <Button Style="{StaticResource DetailToolButtonStyle}" Click="BackButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="#CCFFFFFF" />
                            <TextBlock Text="Back" FontSize="14" Foreground="#CCFFFFFF" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FavoriteButton" Style="{StaticResource DetailToolButtonStyle}" Click="FavoriteButton_Click">
                        <TextBlock x:Name="FavoriteButtonText" Text="♡ Favorite" FontSize="14" Foreground="#CCFFFFFF" />
                    </Button>
                </StackPanel>

                <!-- 主体：2:3 封面 + 右侧玻璃信息层 -->
                <Grid Grid.Row="1" ColumnSpacing="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 2:3 封面 -->
                    <Border Grid.Column="0" Width="208" Height="312" CornerRadius="16"
                            Background="{ThemeResource SurfaceContainerHighestBrush}"
                            BorderBrush="{ThemeResource BorderSoftBrush}" BorderThickness="1">
                        <Grid>
                            <FontIcon Glyph="&#xE714;" FontSize="56" Foreground="{ThemeResource OutlineBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource CardOverlayBrush}" VerticalAlignment="Bottom" />
                            <TextBlock Text="COVER ART" Style="{StaticResource MonoLabelStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                        </Grid>
                    </Border>

                    <!-- 右侧玻璃信息层 -->
                    <StackPanel Grid.Column="1" MaxWidth="680" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource DetailTagPillStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource AccentLightBrush}" />
                                    <TextBlock x:Name="PlatformText" Text="平台: —" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource AccentLightBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DetailTagPillStyle}">
                                <TextBlock Text="IN LIBRARY" Style="{StaticResource MonoLabelStyle}" />
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="TitleText" Text="未选择游戏"
                                   FontFamily="Hanken Grotesk, Segoe UI" FontSize="48" FontWeight="ExtraBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" />

                        <TextBlock x:Name="DescriptionText" Text="从游戏库选择一个游戏查看详情。"
                                   FontFamily="Hanken Grotesk, Segoe UI" FontSize="16" FontWeight="Normal"
                                   Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   LineHeight="24" MaxWidth="600" />

                        <StackPanel Orientation="Horizontal" Spacing="40" Margin="0,12,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="PLAYTIME" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock x:Name="PlayTimeText" Text="累计游玩 0 分钟" Style="{StaticResource StatValueStyle}" FontSize="22" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="TOTAL SESSIONS" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock Text="—" Style="{StaticResource StatValueStyle}" FontSize="22" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,16,0,0">
                            <Button x:Name="LaunchButton" Style="{StaticResource GlassPillButtonStyle}" Click="LaunchButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE768;" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="启动" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="EditButton" Style="{StaticResource GlassPillButtonStyle}" Padding="24,12" Click="EditButton_Click">
                                <TextBlock Text="编辑" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===================== 游玩记录 ===================== -->
                <StackPanel Grid.Row="1" Margin="0,56,0,0" VerticalAlignment="Bottom" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="游玩记录" Style="{StaticResource SectionTitleStyle}" FontSize="24" />
                        <Border Style="{StaticResource DetailTagPillStyle}" VerticalAlignment="Center">
                            <TextBlock Text="SESSION LOG" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextTertiaryBrush}" />
                        </Border>
                    </StackPanel>
                    <ListView x:Name="SessionsList" Width="520" HorizontalAlignment="Left" Background="Transparent"
                              BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12"
                              Padding="8" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
