<Page
    x:Class="GameLibrary.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Hero 玻璃胶囊（Play，对齐 HeroContent.tsx glass rounded-full border-white/20 px-10 py-3） -->
        <Style x:Key="HeroPillStyle" TargetType="Button" BasedOn="{StaticResource AppGlassButtonStyle}">
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Padding" Value="40,14" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Hero 次要按钮（Detail，border-white/15 px-8 py-3 text-base semibold） -->
        <Style x:Key="HeroDetailPillStyle" TargetType="Button" BasedOn="{StaticResource AppGlassButtonStyle}">
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Padding" Value="32,14" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- ===================== 全屏动态背景 =====================
             选中游戏的背景图 + 左暗角渐变 + 底部渐变（对齐 DynamicBackground.tsx） -->
        <Grid x:Name="BackgroundLayer" Background="#121318">
            <!-- 全屏铺满（UniformToFill）：按窗口比例裁切，无黑边；深色底仅在背景缺失时兜底 -->
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0" />
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#A0121318" Offset="0.0" />
                        <GradientStop Color="#66121318" Offset="0.25" />
                        <GradientStop Color="#33121318" Offset="0.5" />
                        <GradientStop Color="#14121318" Offset="0.7" />
                        <GradientStop Color="#00121318" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#55121318" Offset="0.0" />
                        <GradientStop Color="#00121318" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- ===================== 内容层 =====================
             顶部轮播 + 底部左下玻璃信息层 -->
        <Grid Padding="48,104,48,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部 HeroCarousel：横向封面轨道 + 标题 -->
            <Grid Grid.Row="0" VerticalAlignment="Top" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled">
                    <StackPanel x:Name="RecentRail" Orientation="Horizontal" Spacing="16" Padding="0,0,0,24" />
                </ScrollViewer>

                <!-- 选中游戏标题 + 来源标签（对齐 HeroCarousel.tsx） -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="4,0,0,0">
                    <Border x:Name="SourceTagBorder" Background="#1AFFFFFF" BorderBrush="#33FFFFFF"
                            BorderThickness="1" CornerRadius="4" Padding="8,2"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="SourceTagText" Text="Steam"
                                    FontFamily="JetBrains Mono, Consolas" FontSize="10" FontWeight="Bold"
                                    CharacterSpacing="100" Foreground="{ThemeResource TextPrimaryBrush}"
                                    VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="CarouselTitleText" Text=""
                                 FontFamily="Hanken Grotesk, Segoe UI" FontSize="20" FontWeight="SemiBold"
                                 Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 底部左下玻璃信息层（对齐 HeroContent.tsx） -->
            <StackPanel Grid.Row="1" MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Spacing="24">
                <TextBlock x:Name="HeroSubtitleText" Text=""
                           FontFamily="Hanken Grotesk, Segoe UI" FontSize="16" FontWeight="Normal"
                           Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"
                           MaxWidth="520" LineHeight="26" />

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button x:Name="PlayButton" Style="{StaticResource HeroPillStyle}" Click="Resume_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock x:Name="PlayButtonText" Text="Play" FontSize="18" FontWeight="Bold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DetailButton" Style="{StaticResource HeroDetailPillStyle}" Click="More_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE76C;" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="Detail" Tag="i18n:home.detail" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EmptyImportButton" Style="{StaticResource HeroPillStyle}" Click="EmptyImport_Click"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B5;" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="导入游戏" Tag="i18n:home.import" FontSize="18" FontWeight="Bold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 游玩时长进度条（100h cap，对齐 PLAYTIME_CAP_SEC） -->
                <StackPanel Spacing="8">
                    <Border Width="256" Height="4" CornerRadius="2" Background="#1AFFFFFF"
                            HorizontalAlignment="Left">
                        <Border x:Name="PlaytimeBar" HorizontalAlignment="Left" Width="0" CornerRadius="2">
                            <Border.Background>
                                <SolidColorBrush Color="#B4C5FF" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <TextBlock x:Name="PlaytimeText" Text=""
                               FontFamily="JetBrains Mono, Consolas" FontSize="12" FontWeight="Medium"
                               CharacterSpacing="100" Foreground="#66FFFFFF" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
