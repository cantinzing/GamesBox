<Page
    x:Class="GameLibrary.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource BackgroundBaseBrush}">

    <Grid Padding="48,104,48,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Library" Tag="i18n:library.title" Style="{StaticResource SectionTitleStyle}" FontSize="40" FontWeight="ExtraBold" />
            <TextBlock x:Name="StatusText" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextTertiaryBrush}" />
        </StackPanel>

        <!-- 玻璃 Toolbar -->
        <Border Grid.Row="1" Margin="0,28,0,0" Padding="0,0,0,16"
                BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <AutoSuggestBox x:Name="SearchBox" Style="{StaticResource ToolbarInputStyle}"
                                Width="224" PlaceholderText="Search"
                                QueryIcon="Find" TextChanged="SearchBox_TextChanged" />

                <ComboBox x:Name="SortBox" SelectedIndex="0" MinWidth="150"
                          Height="36" CornerRadius="8"
                          Background="#0DFFFFFF" BorderBrush="Transparent" BorderThickness="0"
                          Foreground="{ThemeResource TextPrimaryBrush}"
                          SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="Name" />
                    <ComboBoxItem Content="Recently Played" />
                    <ComboBoxItem Content="Play Time" />
                    <ComboBoxItem Content="Date Added" />
                    <ComboBoxItem Content="Manual" />
                </ComboBox>

                <ToggleButton x:Name="OrderToggle" Style="{StaticResource ToolbarToggleStyle}"
                              Height="36"
                              Content="↓ Desc" Click="OrderToggle_Click" />

                <ComboBox x:Name="SourceBox" SelectedIndex="0" MinWidth="110"
                          Height="36" CornerRadius="8"
                          Background="#0DFFFFFF" BorderBrush="Transparent" BorderThickness="0"
                          Foreground="{ThemeResource TextPrimaryBrush}"
                          SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="All Sources" />
                    <ComboBoxItem Content="Steam" />
                    <ComboBoxItem Content="Epic" />
                    <ComboBoxItem Content="Local" />
                </ComboBox>

                <ComboBox x:Name="TagBox" SelectedIndex="0" MinWidth="140"
                          Height="36" CornerRadius="8"
                          Background="#0DFFFFFF" BorderBrush="Transparent" BorderThickness="0"
                          Foreground="{ThemeResource TextPrimaryBrush}"
                          SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="All Tags" />
                </ComboBox>

                <ToggleButton x:Name="FavoriteToggle" Style="{StaticResource FavoriteToggleStyle}"
                              Height="36"
                              Content="★ Favorite" Click="FavoriteToggle_Click" />

                <ToggleButton x:Name="ManageToggle" Style="{StaticResource ToolbarToggleStyle}"
                              Height="36"
                              Template="{StaticResource ManageToggleTemplate}"
                              Content="批量" Tag="i18n:library.manage" Click="ManageToggle_Click" />
                <Button x:Name="SelectAllButton" Style="{StaticResource GlassPillButtonStyle}"
                        Height="36" Padding="16,8" Visibility="Collapsed" Click="SelectAll_Click">
                    <TextBlock x:Name="SelectAllText" Text="全选" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                </Button>
                <Button x:Name="RemoveSelectedButton" Style="{StaticResource GlassPillButtonStyle}"
                        Height="36" Padding="16,8" Visibility="Collapsed" Click="RemoveSelected_Click">
                    <TextBlock x:Name="RemoveSelectedText" Text="移除所选 (0)" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                </Button>

                <ToggleButton x:Name="GridToggle" Style="{StaticResource ToolbarToggleStyle}"
                        Height="36"
                        Content="▦" Tag="grid" Click="ViewToggle_Click" />
                <ToggleButton x:Name="ListToggle" Style="{StaticResource ToolbarToggleStyle}"
                        Height="36"
                        Content="≡" Tag="list" Click="ViewToggle_Click" />

                <Button Style="{StaticResource GlassPillButtonStyle}" Height="36" Padding="20,8" Tag="import"
                        Click="Import_Click">
                    <TextBlock Text="Import" Tag="i18n:library.import" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,24,0,0">
            <!-- 库网格：2:3 竖版封面 -->
            <GridView x:Name="GameGrid"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="GameGrid_ItemClick"
                      Background="Transparent" Padding="0,0,0,0">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center"
                                       ItemWidth="220" ItemHeight="324" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewItem">
                                    <Grid>
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GridView.ItemContainerStyle>
            </GridView>

            <!-- 库列表：行式视图 -->
            <ListView x:Name="GameList" Visibility="Collapsed"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="GameGrid_ItemClick"
                      Background="Transparent" Padding="0,0,0,0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </Grid>
</Page>
