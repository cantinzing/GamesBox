<Page
    x:Class="GameLibrary.GameDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="DetailTagPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
        <!-- 顶部小按钮（Back / Favorite，bg-white/5） -->
        <Style x:Key="DetailToolButtonStyle" TargetType="Button" BasedOn="{StaticResource AppGlassButtonStyle}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource BackgroundBaseBrush}">
        <!-- 全屏沉浸背景（暗渐变 + 底部灯罩，对齐 GameDetail.tsx bg-ink-950/80） -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#16283F" Offset="0" />
                    <GradientStop Color="#121318" Offset="0.6" />
                    <GradientStop Color="#0D0E13" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border Background="{ThemeResource BottomFadeBrush}" />

        <ScrollViewer>
            <Grid Padding="48,104,48,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部操作条：Back + Favorite + 右上角删除 -->
                <Grid Grid.Row="0" Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource DetailToolButtonStyle}" Click="BackButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="#CCFFFFFF" />
                                <TextBlock Text="Back" Tag="i18n:common.back" FontSize="14" Foreground="#CCFFFFFF" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="FavoriteButton" Style="{StaticResource DetailToolButtonStyle}" Click="FavoriteButton_Click">
                            <TextBlock x:Name="FavoriteButtonText" Text="♡ Favorite" FontSize="14" Foreground="#CCFFFFFF" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="DeleteButton" Grid.Column="2" HorizontalAlignment="Right"
                            Style="{StaticResource DetailToolButtonStyle}" Padding="12,6" Click="DeleteButton_Click">
                        <TextBlock Text="删除" Tag="i18n:detail.delete" FontSize="13" Foreground="#FF9D8B" />
                    </Button>
                </Grid>

                <!-- 主体：2:3 封面 + 右侧玻璃信息层 -->
                <Grid Grid.Row="1" ColumnSpacing="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 2:3 封面 -->
                    <Border Grid.Column="0" Width="208" Height="312" CornerRadius="16"
                            Background="{ThemeResource SurfaceContainerHighestBrush}"
                            BorderBrush="{ThemeResource BorderSoftBrush}" BorderThickness="1">
                        <Grid>
                            <FontIcon Glyph="&#xE714;" FontSize="56" Foreground="{ThemeResource OutlineBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="CoverImage" Stretch="UniformToFill" Opacity="0" />
                            <Border Background="{ThemeResource CardOverlayBrush}" VerticalAlignment="Bottom" />
                            <TextBlock Text="COVER ART" Tag="i18n:detail.coverArt" Style="{StaticResource MonoLabelStyle}"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                        </Grid>
                    </Border>

                    <!-- 右侧玻璃信息层 -->
                    <StackPanel Grid.Column="1" MaxWidth="680" Spacing="12" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource DetailTagPillStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource AccentLightBrush}" />
                                    <TextBlock x:Name="PlatformText" Text="平台: —" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource AccentLightBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DetailTagPillStyle}">
                                <TextBlock Text="IN LIBRARY" Tag="i18n:detail.inLibrary" Style="{StaticResource MonoLabelStyle}" />
                            </Border>
                        </StackPanel>

<TextBlock x:Name="TitleText" Text="未选择游戏"
                                    FontFamily="Hanken Grotesk, Segoe UI" FontSize="36" FontWeight="Bold"
                                    Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" />

                        <TextBlock x:Name="DescriptionText" Text="从游戏库选择一个游戏查看详情。"
                                   FontFamily="Hanken Grotesk, Segoe UI" FontSize="16" FontWeight="Normal"
                                   Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   LineHeight="24" MaxWidth="600" />

                        <StackPanel Orientation="Horizontal" Spacing="40" Margin="0,12,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="PLAYTIME" Tag="i18n:detail.playtime" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock x:Name="PlayTimeText" Text="累计游玩 0 分钟" Style="{StaticResource StatValueStyle}" FontSize="22" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="TOTAL SESSIONS" Tag="i18n:detail.totalSessions" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock Text="—" Style="{StaticResource StatValueStyle}" FontSize="22" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,16,0,0">
                            <Button x:Name="LaunchButton" Style="{StaticResource GlassPillButtonStyle}" Click="LaunchButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE768;" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="启动" Tag="i18n:detail.launch" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="EditButton" Style="{StaticResource GlassPillButtonStyle}" Padding="24,12" Click="EditButton_Click">
                                <TextBlock Text="编辑" Tag="i18n:detail.edit" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            </Button>
                            <Button x:Name="AssetButton" Style="{StaticResource GlassPillButtonStyle}" Padding="24,12" Click="AssetButton_Click">
                                <TextBlock Text="素材" Tag="i18n:detail.assets" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            </Button>
                        </StackPanel>

                        <!-- Steam AppID：手动 / 自动匹配 -->
                        <StackPanel Spacing="8" Margin="0,10,0,0">
                            <TextBlock Text="STEAM APP ID" Tag="i18n:detail.steamAppId" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextTertiaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AppIdBox" Grid.Column="0" PlaceholderText="手动输入 AppID" Tag="i18nph:detail.appIdPlaceholder" Height="36"
                                         VerticalContentAlignment="Center"
                                         Background="#33463A3A" BorderBrush="{ThemeResource BorderSubtleBrush}"
                                         BorderThickness="1" CornerRadius="8" VerticalAlignment="Center"
                                         FontFamily="JetBrains Mono, Consolas" FontSize="13" />
                                <Button Grid.Column="1" Content="保存" Tag="i18n:detail.saveAppId" Click="SaveAppId_Click"
                                        Style="{StaticResource OutlineButtonStyle}" Height="36" Padding="14,6" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="自动匹配" Tag="i18n:detail.autoMatch" Click="AutoMatch_Click"
                                        Style="{StaticResource OutlineButtonStyle}" Height="36" Padding="14,6" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Content="清除" Tag="i18n:detail.clearAppId" Click="ClearAppId_Click"
                                        Style="{StaticResource OutlineButtonStyle}" Height="36" Padding="14,6" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===================== 标签 + 游玩记录 ===================== -->
                <StackPanel Grid.Row="2" Margin="0,40,0,0" Spacing="24">
                    <!-- 标签 -->
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="标签" Tag="i18n:detail.tags" Style="{StaticResource SectionTitleStyle}" FontSize="20" />
                            <Button Content="管理标签" Tag="i18n:detail.manageTags" Style="{StaticResource OutlineButtonStyle}" Padding="16,6"
                                    Click="ManageTags_Click" />
                        </StackPanel>
                        <StackPanel x:Name="TagsPanel" Orientation="Horizontal" Spacing="8" />
                    </StackPanel>

                    <!-- 游玩记录 -->
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="游玩记录" Tag="i18n:detail.playRecords" Style="{StaticResource SectionTitleStyle}" FontSize="24" />
                            <Border Style="{StaticResource DetailTagPillStyle}" VerticalAlignment="Center">
                                <TextBlock Text="SESSION LOG" Tag="i18n:detail.sessionLog" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextTertiaryBrush}" />
                            </Border>
                            <Button x:Name="ClearSessionsButton" Content="清空记录" Tag="i18n:detail.clearSessions" Style="{StaticResource OutlineButtonStyle}"
                                    Padding="16,6" VerticalAlignment="Center" Click="ClearSessions_Click" />
                        </StackPanel>
                        <ListView x:Name="SessionsList" Width="560" HorizontalAlignment="Left" Background="Transparent"
                                  BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12"
                                  Padding="8" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" Foreground="{ThemeResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
