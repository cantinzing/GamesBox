<Application
    x:Class="GameLibrary.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== GameCentral 沉浸式暗色调色板（取自 Figma 设计稿） ===== -->
            <!-- 底色 #121318 -->
            <SolidColorBrush x:Key="BackgroundBaseBrush" Color="#121318" />
            <!-- 玻璃面板不透明底色（rgba(30,31,37,0.6) 近似） -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1F25" />
            <SolidColorBrush x:Key="SurfaceLowBrush" Color="#14151A" />
            <!-- 文本 -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E3E1E9" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C3C6D8" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8D90A1" />
            <!-- 主色 / 高亮（#005AEE / #B4C5FF） -->
            <SolidColorBrush x:Key="AccentBrush" Color="#005AEE" />
            <SolidColorBrush x:Key="AccentLightBrush" Color="#B4C5FF" />
            <!-- 细描边（rgba(66,70,85,0.3) 近似） -->
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#33424655" />
            <SolidColorBrush x:Key="BorderSoftBrush" Color="#66424655" />

            <!-- 主按钮渐变（linear-gradient(90deg,#005AEE,#0052DC)） -->
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#005AEE" Offset="0.0" />
                <GradientStop Color="#0052DC" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Hero 玻璃面板（linear-gradient(145deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01))） -->
            <LinearGradientBrush x:Key="GlassHeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0DFFFFFF" Offset="0.0" />
                <GradientStop Color="#03FFFFFF" Offset="1.0" />
            </LinearGradientBrush>

            <!-- 卡片底部信息层（linear-gradient(0deg, #121318, rgba(18,19,24,0))） -->
            <LinearGradientBrush x:Key="CardOverlayBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F2121318" Offset="0.0" />
                <GradientStop Color="#00121318" Offset="1.0" />
            </LinearGradientBrush>

            <!-- 纵向灯罩（Hero 底部暗色过渡） -->
            <LinearGradientBrush x:Key="BottomFadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00121318" Offset="0.0" />
                <GradientStop Color="#F2121318" Offset="1.0" />
            </LinearGradientBrush>

            <!-- 侧边栏 / 卡片玻璃（in-app acrylic） -->
            <AcrylicBrush x:Key="SidebarAcrylicBrush"
                          TintColor="#1E1F25"
                          TintOpacity="0.6"
                          TintLuminosityOpacity="0.4"
                          FallbackColor="#1E1F25" />
            <AcrylicBrush x:Key="CardAcrylicBrush"
                          TintColor="#1E1F25"
                          TintOpacity="0.6"
                          TintLuminosityOpacity="0.4"
                          FallbackColor="#1E1F25" />

            <!-- ===== 完整 Stitch 色板补齐 ===== -->
            <!-- 表面层级（M3 dark） -->
            <SolidColorBrush x:Key="SurfaceDimBrush" Color="#121318" />
            <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="#0D0E13" />
            <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#1A1B21" />
            <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#1E1F25" />
            <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#292A2F" />
            <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#34343A" />
            <!-- 角色色 -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#B4C5FF" />
            <SolidColorBrush x:Key="OnPrimaryBrush" Color="#002A78" />
            <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#005AEE" />
            <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#E0E5FF" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#A6E6FF" />
            <SolidColorBrush x:Key="SecondaryContainerBrush" Color="#14D1FF" />
            <SolidColorBrush x:Key="TertiaryBrush" Color="#FFB59D" />
            <SolidColorBrush x:Key="OutlineBrush" Color="#8D90A1" />
            <SolidColorBrush x:Key="OutlineVariantBrush" Color="#424655" />
            <!-- 荧光蓝发光 -->
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#1A5AA2EE" />

            <!-- 玻璃面板材质（.glass-panel） -->
            <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3AFFFFFF" Offset="0.0" />
                <GradientStop Color="#1F34343A" Offset="1.0" />
            </LinearGradientBrush>
            <!-- 顶部高光线（shine） -->
            <LinearGradientBrush x:Key="GlassShineBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1AFFFFFF" Offset="0.0" />
                <GradientStop Color="#00FFFFFF" Offset="0.12" />
            </LinearGradientBrush>

            <!-- 发光描边按钮 hover -->
            <Style x:Key="GlassBorderShadow" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassPanelBrush}" />
                <Setter Property="BorderBrush" Value="#4DFFFFFF" />
                <Setter Property="BorderThickness" Value="1,1,0,0" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>

            <!-- 描边/悬浮发光按钮（focus-bloom） -->
            <Style x:Key="BloomButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource OutlineVariantBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="CornerRadius" Value="9999" />
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- ===== 排版样式（Hanken Grotesk 主体 / JetBrains Mono 标签） ===== -->
            <!-- 大写等宽标签：INSTALLED / CLOUD SAVED / PLAYTIME -->
            <Style x:Key="MonoLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="JetBrains Mono, Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <!-- Hero 主标题 72px ExtraBold -->
            <Style x:Key="HeroTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="72" />
                <Setter Property="FontWeight" Value="ExtraBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 区块标题 28px Bold -->
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>

            <!-- 统计数值 28px SemiBold -->
            <Style x:Key="StatValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>

            <!-- 统计单位 18px SemiBold -->
            <Style x:Key="StatUnitStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <!-- 卡片标题 20px Bold -->
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 卡片副信息 14px Regular -->
            <Style x:Key="CardSubStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 侧边栏导航项 16px Bold -->
            <Style x:Key="NavItemTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <!-- 标签胶囊（INSTALLED / CLOUD SAVED） -->
            <Style x:Key="TagPillStyle" TargetType="Border">
                <Setter Property="Background" Value="#1AFFFFFF" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,3" />
            </Style>

            <!-- 侧边栏导航按钮（默认透明、左对齐） -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <!-- 描边按钮（扫描游戏 / 导入） -->
            <Style x:Key="OutlineButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentLightBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Foreground" Value="{ThemeResource AccentLightBrush}" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- 主操作按钮（Resume / PLAY，主色渐变） -->
            <Style x:Key="ResumeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentGradientBrush}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="28,12" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <!-- 圆形更多按钮 -->
            <Style x:Key="MoreButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1AFFFFFF" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSoftBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="CornerRadius" Value="22" />
            </Style>

            <!-- 顶栏圆形图标按钮 -->
            <Style x:Key="TopBarIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>

            <!-- 沉浸式顶部导航文字按钮（Games / Library） -->
            <Style x:Key="TopNavTextStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>

            <!-- 玻璃卡片（.glass：145deg 微白渐变 + 发丝描边） -->
            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
                <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>

            <!-- 玻璃按钮（Hero Play / Detail） -->
            <Style x:Key="GlassPillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#0FFFFFFF" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="CornerRadius" Value="9999" />
                <Setter Property="Padding" Value="28,12" />
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <!-- Toolbar 输入框（搜索 / 排序，bg-white/5） -->
            <Style x:Key="ToolbarInputStyle" TargetType="AutoSuggestBox">
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Height" Value="36" />
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- Toolbar 圆形切换（网格/列表/收藏，bg-white/5） -->
            <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- 游戏库 2:3 封面卡片选中描边（白色 + 柔光） -->
            <Style x:Key="CoverCardFocusStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="#E6FFFFFF" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
