    <!-- =====================================================================
         未打包(unpackaged) WinUI 3 的部署开关 —— 必须显式写死，不能依赖默认值。

         原因：C++ 工程不会自动设置 $(OutputType)，而 WindowsAppSDK 的 targets
         用 $(OutputType) 判断「这是应用程序还是类库」。一旦为空就会走类库分支：

           · Microsoft.WindowsAppSDK.BootstrapCommon.targets
             不会把 WindowsAppSdkBootstrapInitialize 置为 true
             → MddBootstrapAutoInitializer.cpp 不参与编译
             → 进程从不调用 MddBootstrapInitialize
             → 未打包应用无法绑定到 WindowsAppSDK 框架包，
               Microsoft.ui.xaml.dll 加载失败，双击后静默退出（没有任何提示）。

           · Microsoft.Build.Msix.Pri.targets 里 GenerateLibraryLayout 默认为 true
             → 不生成 resources.pri。

         另外 Microsoft.WindowsAppSDK.BootstrapCommon.targets 只在
         WindowsPackageType=None 且非自包含时才置位，所以这里逐项显式声明。
         ===================================================================== -->
    <OutputType>WinExe</OutputType>

    <!-- 部署模式默认「自包含」：WindowsAppSDK 运行时随应用一起分发，目标机器
         【无需安装任何运行时】，解压/双击或安装后即可运行（“解压即用”）。
         代价仅是输出目录大几十 MB。
         需要「框架依赖」（体积小、依赖目标机已装运行时）的产物时，例如 MSIX/Store，
         在命令行显式传 /p:WindowsAppSDKSelfContained=false 覆盖。 -->
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)'==''">true</WindowsAppSDKSelfContained>

    <!-- 下面两个初始化开关互斥，由 WindowsAppSDK 的 AutoInitializer 在编译期读取：
         WindowsAppRuntimeAutoInitializer.cpp（始终参与编译）里的全局静态对象会按需
         自动执行对应初始化。用户代码【不要】再手动调用任何 Initialize()。 -->

    <!-- 框架依赖（未打包）：走 MddBootstrapInitialize，绑定已安装的 WindowsAppSDK 框架包 -->
    <WindowsAppSdkBootstrapInitialize Condition="'$(WindowsAppSDKSelfContained)'!='true' and '$(AppxPackage)'!='true'">true</WindowsAppSdkBootstrapInitialize>
    <!-- 自包含：走 UndockedRegFreeWinRT，加载随应用分发的本地运行时（免注册激活） -->
    <WindowsAppSdkUndockedRegFreeWinRTInitialize Condition="'$(WindowsAppSDKSelfContained)'=='true'">true</WindowsAppSdkUndockedRegFreeWinRTInitialize>

    <!-- =====================================================================
         让「运行时加载失败」变成可见的错误，而不是静默退出。

         默认情况下 WindowsAppSDK 会定义
           MICROSOFT_WINDOWSAPPSDK_UNDOCKEDREGFREEWINRT_AUTO_INITIALIZE_LOADLIBRARY
         于是 UndockedRegFreeWinRT-AutoInitializer.cpp 在【静态初始化期】
         （wWinMain 之前）执行：

             static HMODULE dll{ LoadLibraryExW(L"Microsoft.WindowsAppRuntime.dll", ...) };
             if (!dll) { DebugBreak(); exit(HRESULT_FROM_WIN32(GetLastError())); }

         一旦这个 LoadLibrary 失败（随包运行时不全、依赖 DLL 在目标系统上缺失等），
         进程会【一声不响】地退出：没有窗口、没有报错、没有事件日志，
         用户看到的只有「双击没反应」，而且日志里连一行都留不下。

         关掉这个开关后，改用隐式导入（Microsoft.WindowsAppRuntime.lib 本来就在
         链接依赖里，见 WindowsAppSDK-Nuget-Native.C.props）：
         加载失败会由 Windows 加载器接管，弹出「找不到 XXX.dll」的具名提示，
         直接把缺失的模块名告诉我们。CI 的便携包校验会断言 exe 确实导入了
         Microsoft.WindowsAppRuntime.dll，防止这个开关被悄悄改回去。
         ===================================================================== -->
    <WindowsAppSdkUndockedRegFreeWinRTInitializeLoadLibrary Condition="'$(WindowsAppSDKSelfContained)'=='true'">false</WindowsAppSdkUndockedRegFreeWinRTInitializeLoadLibrary>
      <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>
      <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
