    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <!-- Output paths: unpackaged WinUI (ApplicationType=Windows Store + AppxPackage=false)
       does not get OutDir/IntDir/OutputPath from the Cpp defaults, so define them here.
       Layout mirrors the existing build/ convention (build/bin and build/obj). -->
  <PropertyGroup>
    <OutDir Condition="'$(OutDir)'==''">$(ProjectDir)..\..\build\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir Condition="'$(IntDir)'==''">$(ProjectDir)..\..\build\obj\$(Platform)\$(Configuration)\</IntDir>
    <OutputPath Condition="'$(OutputPath)'==''">$(OutDir)</OutputPath>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
