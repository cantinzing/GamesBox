    <!-- 自包含部署：把 Windows App SDK 运行时 DLL 随 exe 一起输出，Win10/Win11 都无需单独安装运行时。
         仅对 Release 生效（部署产物）；Debug 保持普通 unpackaged，便于本机开发调试。
         注意：自包含 exe 在“已安装 WindowsAppRuntime 框架包”的机器上会与框架包冲突（0xC0000602），
         在干净的 Win10/Win11 上正常。 -->
    <WindowsAppSDKSelfContained Condition="'$(Configuration)'=='Release'">true</WindowsAppSDKSelfContained>
      <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>
      <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <TargetPlatformVersion Condition="'$(TargetPlatformVersion)'==''">$(WindowsTargetPlatformVersion)</TargetPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifiers>win10-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>
