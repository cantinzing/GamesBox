<Application
    x:Class="GameLibrary.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== GameLibrary 沉浸式暗色调色板（取自 Figma 设计稿） ===== -->
            <!-- 底色 #121318 -->
            <SolidColorBrush x:Key="BackgroundBaseBrush" Color="#121318" />
            <!-- 玻璃面板不透明底色（rgba(30,31,37,0.6) 近似） -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1F25" />
            <SolidColorBrush x:Key="SurfaceLowBrush" Color="#14151A" />
            <!-- 文本 -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E3E1E9" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C3C6D8" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8D90A1" />
            <!-- 主色 / 高亮（#005AEE / #B4C5FF） -->
            <SolidColorBrush x:Key="AccentBrush" Color="#005AEE" />
            <SolidColorBrush x:Key="AccentLightBrush" Color="#B4C5FF" />
            <!-- 细描边（rgba(66,70,85,0.3) 近似） -->
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#33424655" />
            <SolidColorBrush x:Key="BorderSoftBrush" Color="#66424655" />

            <!-- ===== 手柄 / 键盘焦点指示 =====
                 本应用的按钮全部是自定义 ControlTemplate，模板里【没有 Focused 视觉状态】，
                 而 Control.UseSystemFocusVisuals 默认是 false —— 结果就是：手柄把焦点挪到按钮上，
                 界面一点反应都没有，用户完全不知道自己在哪。所以这里：
                   1) 覆盖框架的系统焦点框画刷（系统焦点框由框架自己画，跟模板无关）；
                   2) 在各共享样式里打开 UseSystemFocusVisuals（见 AppGlassButtonStyle 等）。
                 系统焦点框是外框(Secondary)+内框(Primary)两层，这里只留内框（主题蓝紫），
                 去掉默认的白色外框，免得跟卡片自己的白描边打架。 -->
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#B4C5FF" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#00000000" />

            <!-- 主按钮渐变（linear-gradient(90deg,#005AEE,#0052DC)） -->
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#005AEE" Offset="0.0" />
                <GradientStop Color="#0052DC" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Hero 玻璃面板（linear-gradient(145deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01))） -->
            <LinearGradientBrush x:Key="GlassHeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0DFFFFFF" Offset="0.0" />
                <GradientStop Color="#03FFFFFF" Offset="1.0" />
            </LinearGradientBrush>

            <!-- 卡片底部信息层（linear-gradient(0deg, #121318, rgba(18,19,24,0))） -->
            <LinearGradientBrush x:Key="CardOverlayBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F2121318" Offset="0.0" />
                <GradientStop Color="#00121318" Offset="1.0" />
            </LinearGradientBrush>

            <!-- 纵向灯罩（Hero 底部暗色过渡） -->
            <LinearGradientBrush x:Key="BottomFadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00121318" Offset="0.0" />
                <GradientStop Color="#F2121318" Offset="1.0" />
            </LinearGradientBrush>

            <!-- 侧边栏 / 卡片玻璃（in-app acrylic） -->
            <AcrylicBrush x:Key="SidebarAcrylicBrush"
                          TintColor="#1E1F25"
                          TintOpacity="0.6"
                          TintLuminosityOpacity="0.4"
                          FallbackColor="#1E1F25" />
            <AcrylicBrush x:Key="CardAcrylicBrush"
                          TintColor="#1E1F25"
                          TintOpacity="0.6"
                          TintLuminosityOpacity="0.4"
                          FallbackColor="#1E1F25" />

            <!-- ContentDialog 毛玻璃遮罩：半透明以透出底层（样式本体见下方 AppGlassButtonStyle 之后） -->
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#59000000" />

            <!-- 下拉框弹出面板 / 搜索建议列表：统一为深色毛玻璃（覆盖 WinUI 默认系统 Acrylic） -->
            <AcrylicBrush x:Key="ComboBoxDropDownBackground"
                          TintColor="#1E1F25"
                          TintOpacity="0.9"
                          TintLuminosityOpacity="0.4"
                          FallbackColor="#1E1F25" />
            <AcrylicBrush x:Key="AutoSuggestBoxSuggestionsListBackground"
                          TintColor="#1E1F25"
                          TintOpacity="0.9"
                          TintLuminosityOpacity="0.4"
                          FallbackColor="#1E1F25" />


            <!-- ===== 完整 Stitch 色板补齐 ===== -->
            <!-- 表面层级（M3 dark） -->
            <SolidColorBrush x:Key="SurfaceDimBrush" Color="#121318" />
            <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="#0D0E13" />
            <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#1A1B21" />
            <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#1E1F25" />
            <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#292A2F" />
            <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#34343A" />
            <!-- 角色色 -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#B4C5FF" />
            <SolidColorBrush x:Key="OnPrimaryBrush" Color="#002A78" />
            <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#005AEE" />
            <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#E0E5FF" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#A6E6FF" />
            <SolidColorBrush x:Key="SecondaryContainerBrush" Color="#14D1FF" />
            <SolidColorBrush x:Key="TertiaryBrush" Color="#FFB59D" />
            <SolidColorBrush x:Key="OutlineBrush" Color="#8D90A1" />
            <SolidColorBrush x:Key="OutlineVariantBrush" Color="#424655" />
            <!-- 荧光蓝发光 -->
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#1A5AA2EE" />

            <!-- 玻璃面板材质（.glass-panel） -->
            <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3AFFFFFF" Offset="0.0" />
                <GradientStop Color="#1F34343A" Offset="1.0" />
            </LinearGradientBrush>
            <!-- 顶部高光线（shine） -->
            <LinearGradientBrush x:Key="GlassShineBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1AFFFFFF" Offset="0.0" />
                <GradientStop Color="#00FFFFFF" Offset="0.12" />
            </LinearGradientBrush>

            <!-- 发光描边按钮 hover -->
            <Style x:Key="GlassBorderShadow" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassPanelBrush}" />
                <Setter Property="BorderBrush" Value="#4DFFFFFF" />
                <Setter Property="BorderThickness" Value="1,1,0,0" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>

            <!-- 描边/悬浮发光按钮（focus-bloom） -->
            <Style x:Key="BloomButtonStyle" TargetType="Button" BasedOn="{StaticResource AppGlassButtonStyle}">
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <!-- ===== 圆角按钮通用模板 =====
                 WinUI 默认 Button 模板只在背景 Border 上应用 CornerRadius，
                 hover/pressed 叠层与内容层是矩形，导致悬停/子元素出现方角。
                 这里把背景、hover、pressed、内容全部包进同一个 Border，
                 统一按 {TemplateBinding CornerRadius} 裁剪。 -->
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#26FFFFFF" />

            <!-- 全局玻璃按钮（对齐设置页"保存设置"按钮：bg-white/5 border-white/10 圆角 8） -->
            <Style x:Key="AppGlassButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
                <!-- 手柄 / 键盘焦点框：模板里没画 Focused 状态，交给系统画（见 FocusVisualPrimaryBrush 处说明）。
                     本样式是几乎所有按钮的基类，改这一处就等于全应用生效。 -->
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-4" />
            </Style>

            <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Background" Value="{StaticResource ControlHoverBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Background" Value="{StaticResource ControlPressedBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Opacity" Value="0.5" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="RoundedToggleButtonTemplate" TargetType="ToggleButton">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Background" Value="{StaticResource ControlHoverBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Background" Value="{StaticResource ControlPressedBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Opacity" Value="0.5" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="CheckStates">
                            <VisualState x:Name="Checked">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Background" Value="#26FFFFFF" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Unchecked" />
                            <VisualState x:Name="Indeterminate" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </Grid>
            </ControlTemplate>

            <!-- ===== 系统强调色按钮覆盖 =====
                 ContentDialog 模板中 DefaultButtonStates 视觉状态会强制把默认按钮
                 切换为 {StaticResource AccentButtonStyle}（系统蓝色渐变），且该引用
                 在 XBF 编译时绑定 generic.xaml 字典，App 覆盖同名 key 无效。
                 因此下面整体复制 ContentDialog 模板，仅把该引用改为 AppGlassButtonStyle。 -->
            <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AppGlassButtonStyle}">
                <Setter Property="Padding" Value="16,8" />
            </Style>

            <!-- ContentDialog 毛玻璃全局样式：Acrylic 背景 + 白描边 + 玻璃按钮（完整复制默认模板） -->
            <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="Background" Value="{StaticResource CardAcrylicBrush}" />
                <Setter Property="BorderBrush" Value="#26FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="PrimaryButtonStyle" Value="{StaticResource AppGlassButtonStyle}" />
                <Setter Property="SecondaryButtonStyle" Value="{StaticResource AppGlassButtonStyle}" />
                <Setter Property="CloseButtonStyle" Value="{StaticResource AppGlassButtonStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentDialog">
                            <Border x:Name="Container">

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="DialogShowingStates">

                                        <VisualStateGroup.Transitions>
                                            <VisualTransition To="DialogHidden">

                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="IsHitTestVisible">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="False" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                                                        <SplineDoubleKeyFrame KeyTime="{ThemeResource ControlFastAnimationDuration}" KeySpline="{ThemeResource ControlFastOutSlowInKeySpline}" Value="1.05" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                                                        <SplineDoubleKeyFrame KeyTime="{ThemeResource ControlFastAnimationDuration}" KeySpline="{ThemeResource ControlFastOutSlowInKeySpline}" Value="1.05" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                                                        <LinearDoubleKeyFrame KeyTime="{ThemeResource ControlFasterAnimationDuration}" Value="0.0" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualTransition>
                                            <VisualTransition To="DialogShowing">

                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.05" />
                                                        <SplineDoubleKeyFrame KeyTime="{ThemeResource ControlNormalAnimationDuration}" KeySpline="{ThemeResource ControlFastOutSlowInKeySpline}" Value="1.0" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.05" />
                                                        <SplineDoubleKeyFrame KeyTime="{ThemeResource ControlNormalAnimationDuration}" KeySpline="{ThemeResource ControlFastOutSlowInKeySpline}" Value="1.0" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.0" />
                                                        <LinearDoubleKeyFrame KeyTime="{ThemeResource ControlFasterAnimationDuration}" Value="1.0" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="DialogHidden" />
                                        <VisualState x:Name="DialogShowing">
                                            <VisualState.Setters>
                                                <Setter Target="PrimaryButton.IsTabStop" Value="True" />
                                                <Setter Target="SecondaryButton.IsTabStop" Value="True" />
                                                <Setter Target="CloseButton.IsTabStop" Value="True" />
                                                <Setter Target="LayoutRoot.Visibility" Value="Visible" />
                                                <Setter Target="BackgroundElement.TabFocusNavigation" Value="Cycle" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="DialogShowingWithoutSmokeLayer">
                                            <VisualState.Setters>
                                                <Setter Target="PrimaryButton.IsTabStop" Value="True" />
                                                <Setter Target="SecondaryButton.IsTabStop" Value="True" />
                                                <Setter Target="CloseButton.IsTabStop" Value="True" />
                                                <Setter Target="LayoutRoot.Visibility" Value="Visible" />
                                                <Setter Target="LayoutRoot.Background" Value="{x:Null}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="DialogSizingStates">
                                        <VisualState x:Name="DefaultDialogSizing" />
                                        <VisualState x:Name="FullDialogSizing">
                                            <VisualState.Setters>
                                                <Setter Target="BackgroundElement.VerticalAlignment" Value="Stretch" />
                                            </VisualState.Setters>
                                        </VisualState>

                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ButtonsVisibilityStates">
                                        <VisualState x:Name="AllVisible">
                                            <VisualState.Setters>
                                                <Setter Target="FirstSpacer.Width" Value="{ThemeResource ContentDialogButtonSpacing}" />
                                                <Setter Target="SecondaryColumn.Width" Value="*" />
                                                <Setter Target="SecondaryButton.(Grid.Column)" Value="2" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="NoneVisible">
                                            <VisualState.Setters>
                                                <Setter Target="CommandSpace.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PrimaryVisible">
                                            <VisualState.Setters>
                                                <Setter Target="PrimaryButton.(Grid.Column)" Value="4" />
                                                <Setter Target="SecondaryButton.Visibility" Value="Collapsed" />
                                                <Setter Target="CloseButton.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SecondaryVisible">
                                            <VisualState.Setters>
                                                <Setter Target="SecondaryButton.(Grid.Column)" Value="4" />
                                                <Setter Target="PrimaryButton.Visibility" Value="Collapsed" />
                                                <Setter Target="CloseButton.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CloseVisible">
                                            <VisualState.Setters>
                                                <Setter Target="PrimaryButton.Visibility" Value="Collapsed" />
                                                <Setter Target="SecondaryButton.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PrimaryAndSecondaryVisible">
                                            <VisualState.Setters>
                                                <Setter Target="SecondaryButton.(Grid.Column)" Value="4" />
                                                <Setter Target="CloseButton.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PrimaryAndCloseVisible">
                                            <VisualState.Setters>
                                                <Setter Target="SecondaryButton.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SecondaryAndCloseVisible">
                                            <VisualState.Setters>
                                                <Setter Target="PrimaryButton.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>

                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="DefaultButtonStates">
                                        <VisualState x:Name="NoDefaultButton" />
                                        <VisualState x:Name="PrimaryAsDefaultButton" />
                                        <VisualState x:Name="SecondaryAsDefaultButton" />
                                        <VisualState x:Name="CloseAsDefaultButton" />

                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="DialogBorderStates">
                                        <VisualState x:Name="NoBorder" />
                                        <VisualState x:Name="AccentColorBorder">
                                            <VisualState.Setters>
                                                <Setter Target="BackgroundElement.BorderBrush" Value="{ThemeResource SystemControlForegroundAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                    </VisualStateGroup>

                                </VisualStateManager.VisualStateGroups>
                                <Grid x:Name="LayoutRoot" Visibility="Collapsed">
                                    <Rectangle x:Name="SmokeLayerBackground" Fill="{ThemeResource ContentDialogSmokeFill}" />
                                    <Border x:Name="BackgroundElement" Background="{TemplateBinding Background}" FlowDirection="{TemplateBinding FlowDirection}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" BackgroundSizing="InnerBorderEdge" CornerRadius="{TemplateBinding CornerRadius}" MinWidth="{ThemeResource ContentDialogMinWidth}" MaxWidth="{ThemeResource ContentDialogMaxWidth}" MinHeight="{ThemeResource ContentDialogMinHeight}" MaxHeight="{ThemeResource ContentDialogMaxHeight}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ScaleTransform" />
                                        </Border.RenderTransform>
                                        <Grid x:Name="DialogSpace" CornerRadius="{ThemeResource OverlayCornerRadius}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ScrollViewer x:Name="ContentScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" ZoomMode="Disabled" IsTabStop="False">
                                                <Grid Background="{ThemeResource ContentDialogTopOverlay}" Padding="{ThemeResource ContentDialogPadding}" BorderThickness="{ThemeResource ContentDialogSeparatorThickness}" BorderBrush="{ThemeResource ContentDialogSeparatorBorderBrush}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <ContentControl x:Name="Title" Margin="{ThemeResource ContentDialogTitleMargin}" Content="{TemplateBinding Title}" ContentTemplate="{TemplateBinding TitleTemplate}" FontSize="20" FontFamily="{ThemeResource ContentControlThemeFontFamily}" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" IsTabStop="False">
                                                        <ContentControl.Template>
                                                            <ControlTemplate TargetType="ContentControl">
                                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                    MaxLines="2"
                                                                    TextWrapping="Wrap"
                                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                    Margin="{TemplateBinding Padding}"
                                                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                            </ControlTemplate>
                                                        </ContentControl.Template>
                                                    </ContentControl>
                                                    <ContentPresenter x:Name="Content" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" FontSize="{ThemeResource ControlContentThemeFontSize}" FontFamily="{ThemeResource ContentControlThemeFontFamily}" Foreground="{TemplateBinding Foreground}" Grid.Row="1" TextWrapping="Wrap" />
                                                </Grid>
                                            </ScrollViewer>
                                            <Grid x:Name="CommandSpace" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" XYFocusKeyboardNavigation="Enabled" Padding="{ThemeResource ContentDialogPadding}" Background="{TemplateBinding Background}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
                                                    <ColumnDefinition x:Name="FirstSpacer" Width="0" />
                                                    <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
                                                    <ColumnDefinition x:Name="SecondSpacer" Width="{ThemeResource ContentDialogButtonSpacing}" />
                                                    <ColumnDefinition x:Name="CloseColumn" Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="PrimaryButton" IsTabStop="False" Content="{TemplateBinding PrimaryButtonText}" IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}" Style="{TemplateBinding PrimaryButtonStyle}" ElementSoundMode="FocusOnly" HorizontalAlignment="Stretch" />
                                                <Button x:Name="SecondaryButton" IsTabStop="False" Content="{TemplateBinding SecondaryButtonText}" IsEnabled="{TemplateBinding IsSecondaryButtonEnabled}" Style="{TemplateBinding SecondaryButtonStyle}" ElementSoundMode="FocusOnly" HorizontalAlignment="Stretch" />
                                                <Button x:Name="CloseButton" IsTabStop="False" Grid.Column="4" Content="{TemplateBinding CloseButtonText}" Style="{TemplateBinding CloseButtonStyle}" ElementSoundMode="FocusOnly" HorizontalAlignment="Stretch" />
                                            </Grid>

                                        </Grid>
                                    </Border>

                                </Grid>
                            </Border>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 库卡片按钮：内容上层加一个圆角高亮层，hover 时白边 + 白雾（对齐 GameCard hover:border-white/40） -->
            <ControlTemplate x:Key="CardButtonTemplate" TargetType="Button">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="HoverLayer.BorderBrush" Value="#66FFFFFF" />
                                    <Setter Target="HoverLayer.Background" Value="#0DFFFFFF" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="HoverLayer.BorderBrush" Value="#99FFFFFF" />
                                    <Setter Target="HoverLayer.Background" Value="#14FFFFFF" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Opacity" Value="0.5" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                    <Border x:Name="HoverLayer"
                            IsHitTestVisible="False"
                            BorderBrush="Transparent"
                            Background="Transparent"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                </Grid>
            </ControlTemplate>

            <!-- 首页轮播卡片按钮：无 hover 白框（选中卡片鼠标停留时不显示外层描边） -->
            <ControlTemplate x:Key="CardButtonTemplateNoHover" TargetType="Button">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver" />
                            <VisualState x:Name="Pressed" />
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Opacity" Value="0.5" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </Grid>
            </ControlTemplate>

            <!-- ===== 排版样式（Hanken Grotesk 主体 / JetBrains Mono 标签） ===== -->

            <!-- 屏幕键盘键（虚拟键盘用户控件使用；原定义在 UserControl.Resources 但代码从 Application.Resources 查找） -->
            <Style x:Key="KeyboardKeyStyle" TargetType="Button">
                <Setter Property="Background" Value="#1AFFFFFF" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,2" />
                <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-2" />
            </Style>

            <!-- 功能键：更宽 -->
            <Style x:Key="KeyboardWideKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyboardKeyStyle}">
                <Setter Property="Width" Value="96" />
            </Style>

            <!-- 大写等宽标签：INSTALLED / CLOUD SAVED / PLAYTIME -->
            <Style x:Key="MonoLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="JetBrains Mono, Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <!-- Hero 主标题 72px ExtraBold -->
            <Style x:Key="HeroTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="72" />
                <Setter Property="FontWeight" Value="ExtraBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 区块标题 28px Bold -->
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>

            <!-- 统计数值 28px SemiBold -->
            <Style x:Key="StatValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>

            <!-- 统计单位 18px SemiBold -->
            <Style x:Key="StatUnitStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <!-- 卡片标题 20px Bold -->
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 卡片副信息 14px Regular -->
            <Style x:Key="CardSubStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 侧边栏导航项 16px Bold -->
            <Style x:Key="NavItemTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <!-- 标签胶囊（INSTALLED / CLOUD SAVED） -->
            <Style x:Key="TagPillStyle" TargetType="Border">
                <Setter Property="Background" Value="#1AFFFFFF" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10,4" />
            </Style>

            <!-- 侧边栏导航按钮（默认透明、左对齐） -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <!-- 描边按钮（扫描游戏 / 导入） -->
            <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource AppGlassButtonStyle}">
                <Setter Property="Padding" Value="14,8" />
            </Style>

            <!-- 主操作按钮（Resume / PLAY，主色渐变） -->
            <Style x:Key="ResumeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentGradientBrush}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="28,12" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <!-- 圆形更多按钮 -->
            <Style x:Key="MoreButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1AFFFFFF" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSoftBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="CornerRadius" Value="22" />
            </Style>

            <!-- 顶栏圆形图标按钮 -->
            <Style x:Key="TopBarIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
            </Style>

            <!-- 沉浸式顶部导航文字按钮（Games / Library） -->
            <Style x:Key="TopNavTextStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
            </Style>

            <!-- 玻璃卡片（.glass：145deg 微白渐变 + 发丝描边） -->
            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
                <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>

            <!-- 玻璃按钮（Hero Play / Detail） -->
            <Style x:Key="GlassPillButtonStyle" TargetType="Button" BasedOn="{StaticResource AppGlassButtonStyle}">
                <Setter Property="Padding" Value="28,12" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <!-- Toolbar 输入框（搜索 / 排序，bg-white/5） -->
            <Style x:Key="ToolbarInputStyle" TargetType="AutoSuggestBox">
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Height" Value="36" />
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- Toolbar 圆形切换（网格/列表/收藏，bg-white/5） -->
            <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template" Value="{StaticResource RoundedToggleButtonTemplate}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
            </Style>

            <!-- 游戏库 2:3 封面卡片选中描边（白色 + 柔光） -->
            <Style x:Key="CoverCardFocusStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="#E6FFFFFF" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <!-- 收藏开关模板：选中态黄色（bg-yellow-400/20 text-yellow-300，对齐前端） -->
            <ControlTemplate x:Key="FavoriteToggleTemplate" TargetType="ToggleButton">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Background" Value="{StaticResource ControlHoverBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Background" Value="{StaticResource ControlPressedBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Opacity" Value="0.5" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="CheckStates">
                            <VisualState x:Name="Checked">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Background" Value="#33F0D050" />
                                    <Setter Target="RootBorder.BorderBrush" Value="#66F0D050" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Unchecked" />
                            <VisualState x:Name="Indeterminate" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </Grid>
            </ControlTemplate>

            <!-- 批量选择开关模板：选中态无紫色，仅浅白背景 + 白字 -->
            <ControlTemplate x:Key="ManageToggleTemplate" TargetType="ToggleButton">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Background" Value="{StaticResource ControlHoverBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Background" Value="{StaticResource ControlPressedBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Opacity" Value="0.5" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="CheckStates">
                            <VisualState x:Name="Checked">
                                <VisualState.Setters>
                                    <Setter Target="RootBorder.Background" Value="#26FFFFFF" />
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Unchecked" />
                            <VisualState x:Name="Indeterminate" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </Grid>
            </ControlTemplate>

            <!-- 收藏开关（工具栏 / 覆盖层，选中变黄） -->
            <Style x:Key="FavoriteToggleStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontFamily" Value="Hanken Grotesk, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template" Value="{StaticResource FavoriteToggleTemplate}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
            </Style>

            <!-- 卡片右上角收藏星标（未选中白字 40%，选中黄色胶囊） -->
            <Style x:Key="FavoriteStarStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#66FFFFFF" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Template" Value="{StaticResource FavoriteToggleTemplate}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
