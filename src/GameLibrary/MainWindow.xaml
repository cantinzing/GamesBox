<Window
    x:Class="GameLibrary.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLibrary"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource BackgroundBaseBrush}" KeyDown="MainWindow_KeyDown">

        <!-- 内容帧（每个页面自己画全屏沉浸背景） -->
        <Frame x:Name="ContentFrame" />

        <!-- 顶部遮罩：滚动时淡入，保证浮层按钮在滚动内容之上可读（位于 TopBar 之下） -->
        <Border x:Name="TopBarScrim" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="96" Opacity="0"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#121318" Offset="0" />
                    <GradientStop Color="#121318" Offset="0.55" />
                    <GradientStop Color="#00121318" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ===================== 浮动 TopBar（对齐 TopBar.tsx） =====================
             透明浮层：左侧文字导航 + 整行可拖拽 + 右侧圆形图标按钮 -->
        <Grid x:Name="TopBarHost" VerticalAlignment="Top" Height="96">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 拖拽区仅覆盖中间空白：避开左侧导航与右侧按钮。
                 标题栏区域内的点击会被系统优先做激活/拖动处理，偶发吞掉按钮 Click -->
            <Grid x:Name="DragRegion" Grid.Column="1" Background="Transparent" Margin="0,0,150,0" />

            <!-- 左侧：Games / Library 文字导航 -->
            <StackPanel x:Name="NavHost" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="48,28,0,0">
                <Button x:Name="NavHome" Tag="home" Click="NavButton_Click" Style="{StaticResource TopNavTextStyle}">
                    <TextBlock x:Name="NavHomeLabel" Text="Games"
                               FontFamily="Hanken Grotesk, Segoe UI" FontSize="22" FontWeight="Medium"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
                <Button x:Name="NavLibrary" Tag="library" Click="NavButton_Click" Style="{StaticResource TopNavTextStyle}">
                    <TextBlock x:Name="NavLibraryLabel" Text="Library"
                               FontFamily="Hanken Grotesk, Segoe UI" FontSize="22" FontWeight="Medium"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
            </StackPanel>

            <!-- 右侧：搜索 / 帮助 / 设置（右侧预留原生 Win32 标题栏按钮空间） -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,28,48,0">
                <Button x:Name="NavSearch" Tag="search" Click="NavSearch_Click" Style="{StaticResource TopBarIconButtonStyle}"
                        AutomationProperties.Name="Search">
                    <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
                <Button x:Name="NavHelp" Click="NavHelp_Click" Style="{StaticResource TopBarIconButtonStyle}"
                        AutomationProperties.Name="Help">
                    <FontIcon Glyph="&#xE897;" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
                <Button x:Name="NavSettings" Tag="settings" Click="NavButton_Click" Style="{StaticResource TopBarIconButtonStyle}"
                        AutomationProperties.Name="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== 全局搜索覆盖层（对齐 SearchOverlay.tsx） ===================== -->
        <Border x:Name="SearchOverlay" Visibility="Collapsed" Background="#99000000" IsHitTestVisible="True">
            <Grid>
                <Border Width="760" VerticalAlignment="Top" Margin="0,112,0,0"
                        Background="{StaticResource CardAcrylicBrush}" CornerRadius="20" BorderBrush="#26FFFFFF" BorderThickness="1"
                        Padding="0,0,0,12">
                    <StackPanel>
                        <!-- 输入行 -->
                        <Grid Padding="20,18" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="#66FFFFFF"
                                      VerticalAlignment="Center" />
                            <TextBox x:Name="SearchSearchBox" Grid.Column="1"
                                     TextChanged="SearchSearchBox_TextChanged" KeyDown="SearchOverlay_KeyDown"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="White" FontSize="18"
                                     PlaceholderText="搜索游戏…" PlaceholderForeground="#66FFFFFF"
                                     FontFamily="Hanken Grotesk, Segoe UI" />
                            <Button x:Name="SearchClearBtn" Grid.Column="2" Click="SearchClear_Click"
                                    Style="{StaticResource TopBarIconButtonStyle}" AutomationProperties.Name="Close">
                                <FontIcon Glyph="&#xE8BB;" FontSize="16" Foreground="#66FFFFFF" />
                            </Button>
                        </Grid>

                        <!-- 筛选行 -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,0,20,12">
                            <ComboBox x:Name="SearchSourceBox" Width="130" Height="34" CornerRadius="8"
                                      SelectedIndex="0"
                                      Background="#0DFFFFFF" BorderBrush="Transparent" BorderThickness="0"
                                      SelectionChanged="SearchFilter_Changed">
                                <ComboBoxItem Content="全部来源" />
                                <ComboBoxItem Content="Steam" />
                                <ComboBoxItem Content="Epic" />
                                <ComboBoxItem Content="本地" />
                            </ComboBox>
                            <ComboBox x:Name="SearchSortBox" Width="150" Height="34" CornerRadius="8"
                                      SelectedIndex="0"
                                      Background="#0DFFFFFF" BorderBrush="Transparent" BorderThickness="0"
                                      SelectionChanged="SearchFilter_Changed">
                                <ComboBoxItem Content="按名称" />
                                <ComboBoxItem Content="按最近游玩" />
                                <ComboBoxItem Content="按游玩时长" />
                            </ComboBox>
                            <ToggleButton x:Name="SearchFavToggle" Style="{StaticResource FavoriteToggleStyle}"
                                          Content="★ 只看收藏" Click="SearchFavorite_Click" />
                            <TextBlock x:Name="SearchCountText" Style="{StaticResource MonoLabelStyle}"
                                       Foreground="#66FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </StackPanel>

                        <!-- 结果列表 -->
                        <ScrollViewer x:Name="SearchResultsScroller" MaxHeight="420">
                            <ItemsControl x:Name="SearchResultsList" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== 帮助覆盖层（对齐 HelpOverlay.tsx） ===================== -->
        <Border x:Name="HelpOverlay" Visibility="Collapsed" Background="#99000000" IsHitTestVisible="True">
            <Grid>
                <Border Width="640" VerticalAlignment="Center" Background="{StaticResource CardAcrylicBrush}"
                        CornerRadius="20" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="36,30">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="8">
                            <Border Style="{StaticResource TagPillStyle}" HorizontalAlignment="Left">
                                <TextBlock x:Name="HelpTagText" Text="HELP &amp; SHORTCUTS" Style="{StaticResource MonoLabelStyle}"
                                           Foreground="{ThemeResource AccentLightBrush}" />
                            </Border>
                            <TextBlock x:Name="HelpTitle" Text="帮助" Style="{StaticResource SectionTitleStyle}" FontSize="32" FontWeight="ExtraBold" />
                        </StackPanel>

                        <Border Background="#33463A3A" CornerRadius="12" Padding="20,16">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="HelpShortcutsTitle" FontFamily="Hanken Grotesk, Segoe UI" FontSize="16" FontWeight="Bold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" Text="快捷键" />
                                <TextBlock x:Name="HelpKeySearch" Text="Ctrl + F — 全局搜索" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock x:Name="HelpKeyEsc" Text="Esc — 关闭当前覆盖层" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock x:Name="HelpKeyHelp" Text="F1 — 打开 / 关闭帮助" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#33463A3A" CornerRadius="12" Padding="20,16">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="HelpUsageTitle" FontFamily="Hanken Grotesk, Segoe UI" FontSize="16" FontWeight="Bold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" Text="使用说明" />
                                <TextBlock x:Name="HelpU1" Text="· 在首页轮播中选择或启动游戏" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock x:Name="HelpU2" Text="· 在库页导入 Steam / Epic / 本地游戏" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock x:Name="HelpU3" Text="· 详情页可编辑、打标签、管理素材与记录" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock x:Name="HelpU4" Text="· 前往设置配置 IGDB / SteamGridDB 抓取元数据" Style="{StaticResource MonoLabelStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="HelpGotIt" Content="我知道了" Click="HelpClose_Click" Style="{StaticResource OutlineButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== 导入向导覆盖层（Frame 承载 ImportWizardPage，毛玻璃弹窗） ===================== -->
        <Border x:Name="ImportOverlay" Visibility="Collapsed" Background="#99000000" IsHitTestVisible="True">
            <Frame x:Name="ImportOverlayFrame" Background="Transparent" />
        </Border>

        <!-- ===================== 全局加载覆盖层（转圈 + 文案，表示正在处理） ===================== -->
        <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="#A6000000" IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                <ProgressRing x:Name="LoadingSpinner" Width="64" Height="64" IsActive="True"
                              Foreground="{ThemeResource AccentLightBrush}" />
                <TextBlock x:Name="LoadingText" Text="设置中…" FontFamily="Hanken Grotesk, Segoe UI"
                           FontSize="15" Foreground="{ThemeResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>